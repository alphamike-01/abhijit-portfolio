# ==============================================================================
# ENVIRONMENT VARIABLES & DEPLOYMENT CONFIGURATION — ABHIJIT MONDAL PORTFOLIO
# ==============================================================================

# Public Canonical Site URL
VITE_SITE_URL=https://abhijitmondal.dev

# Initial Administrative Provisioning
VITE_ADMIN_DEFAULT_EMAIL=admin@abhijitmondal.dev

# Google AdSense Monetization (Configure after Google account approval)
# Example: ca-pub-1234567890123456
VITE_ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
VITE_ADSENSE_PREVIEW_MODE=true

# Security & Session Settings
VITE_SESSION_TIMEOUT_HOURS=8
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION_MINUTES=15

# Environment Mode: development | staging | production
VITE_ENVIRONMENT=production
